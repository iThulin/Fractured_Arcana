+	/// Called once, at Initialize; Reshuffle deliberately does not, which is the
+	/// spec's "then shuffles normally".</summary>
+	private void SurfaceInnates()
+	{
+		var innate = DrawPile.FindAll(c => c != null && c.Innate);
+		if (innate.Count == 0)
