     private static Color BlightStain(Color baseColor, int level)
-        => baseColor.Lerp(UITheme.CampusBlightTint, Mathf.Clamp(level, 0, 3) * 0.22f);
+        => baseColor.Lerp(UITheme.CampusBlightTint, Mathf.Clamp(level, 0, 3) switch
