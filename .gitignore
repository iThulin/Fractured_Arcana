# Godot 4+ specific ignores
.godot/
.import/
.mono/
*.tmp
*.temp
*.user
*.csproj.user
*.old*
*.lscache
.DS_Store
*.tscn -merge
*.tres -merge

# Compile-check output (tools/build-check.cmd)
build.log
hang_watchdog*.log

# Python bytecode from tools/glyph_cipher (the glyph cipher reference impl)
__pycache__/
*.pyc

# Scratch used by the remote-file bridge, which cannot delete. Safe to remove
# by hand at any time; ignored so it never lands in a commit.
_to_delete/

# Blender source files and backups: too large for GitHub
*.blend
*.blend1
*.blend.import

# Claude outputs/ is the drop folder for apply scripts and drop-in copies from Claude
# sessions. Once applied they are never needed by the game, so the folder stays out of
# git, and its .gdignore keeps Godot from importing it (the .csproj already keeps its
# .cs copies out of the build).
Claude outputs/*
!Claude outputs/.gdignore
