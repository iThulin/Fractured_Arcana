  "lines": [
    {
      "key": "shadow",
      "when": {
        "beat": "parcel",
        "traitor": "namer"
      },
      "text": "The Register notes that the last delivery this hand arranged was a candidate to the dais, and that it did not go as drawn."
    },
    {
      "key": "shadow",
      "when": {
        "beat": "witness",
        "traitor": "namer"
      },
      "text": "The Register notes that the Namer once watched a whole hall from the honored chair, and saw everything in it but you."
    },
    {
      "key": "shadow",
      "when": {
        "beat": "clause",
        "traitor": "namer"
      },
      "text": "The Register notes that the Namer's papers were withdrawn once before. It does not say what else was."
    },
    {
      "key": "shadow",
      "when": {},
      "text": ""
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "ask",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'One layer last time as well. The Register checked it twice then, too.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "five",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same four cards. The same word. They still have not said it to anyone else.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "inside",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same six layers. The Register still cannot see the seventh.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "shadow_ask",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'One layer, last time too. Somewhere else, they said.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "shadow_five",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same name, given the same way.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "shadow_end",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same drawings. You were not in them last time either.'"
    },
    {
      "key": "remembrance",
      "when": {},
      "text": ""
    }
  ]
