  "lines": [
    {
      "key": "study_way_in",
      "when": {
        "route": "hall"
      },
      "text": "The stair goes up inside the wall, and turns, and turns again. It is evening by the time it comes out at a door, standing open."
    },
    {
      "key": "study_way_in",
      "when": {
        "route": "gate"
      },
      "text": "The gate is open again, and the Keepers let the party through. You cross the hall without a roof to the stair behind the dais and climb it, and it is evening by the time you reach the door at the top, standing open."
    },
    {
      "key": "seats_answered",
      "when": {
        "answered_seats": "6"
      },
      "text": "'Be it recorded,' says the Register, very formally, as if it has been waiting a long time to say it, 'that six of the seven seats are answered in this reading. One is left.'"
    },
    {
      "key": "seats_answered",
      "when": {
        "answered_seats": "7"
      },
      "text": "'Be it recorded,' says the Register, very formally, as if it has been waiting a long time to say it, 'that all seven seats are answered in this reading.'"
    },
