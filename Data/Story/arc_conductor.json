  "lines": [
    {
      "key": "trial_title",
      "when": {
        "n": "1"
      },
      "text": "The First Order"
    },
    {
      "key": "trial_title",
      "when": {
        "n": "2"
      },
      "text": "The Second Order"
    },
    {
      "key": "trial_followup",
      "when": {
        "n": "1"
      },
      "text": "'That's one,' she says. 'Fill me another.'"
    },
    {
      "key": "trial_followup",
      "when": {
        "n": "2"
      },
      "text": "'Two filled,' she says. 'Come back to the table. I'll pour, and you'll tell me the third.'"
    },
    {
      "key": "shadow",
      "when": {
        "beat": "field",
        "traitor": "conductor"
      },
      "text": "The Register notes that Dace has never asked Ondria how the hall fell, and that she has never offered to tell him."
    },
    {
      "key": "shadow",
      "when": {
        "beat": "table",
        "traitor": "conductor"
      },
      "text": "The Register notes that Ivo's bowl was full tonight, and that Ondria did not fill it. She could not lift the jug."
    },
    {
      "key": "shadow",
      "when": {
        "beat": "road",
        "traitor": "conductor"
      },
      "text": "The Register notes the day Pell died: a week after the hall, a day short of home, of something that came in through the opened Seal. It does not remark on it."
    },
    {
      "key": "shadow",
      "when": {},
      "text": ""
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "ask",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same three at the bar. The same orders. Dace asked first last time too.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "fault",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'She asked the same question. She poured herself the same drink.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "inside",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same names, in the same order. She did not pour last time either.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "shadow_ask",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'A fourth glass last time too. Nobody drank it.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "shadow_fault",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'She has always known. She said so last time, in the same words.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "shadow_end",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same rows. She knew every face last time, too.'"
    },
    {
      "key": "remembrance",
      "when": {},
      "text": ""
    }
  ]
