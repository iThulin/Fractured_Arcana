  "lines": [
    {
      "key": "trial_outcome",
      "when": {
        "won": "true"
      },
      "text": "You won. The device is warm, and smells of hot tin."
    },
    {
      "key": "trial_outcome",
      "when": {
        "won": "false"
      },
      "text": "You lost. The device is warm, and smells of hot tin, and does not seem to mind."
    },
    {
      "key": "shadow",
      "when": {
        "beat": "steady_hand",
        "traitor": "engineer"
      },
      "text": "The Register notes that the hand that built this device was steady once before, on the dais, with its palm on the glass."
    },
    {
      "key": "shadow",
      "when": {
        "beat": "second_opinion",
        "traitor": "engineer"
      },
      "text": "The Register notes that the box clicked once at the very start of the fight, before anything had happened. It does not say what it was warning about."
    },
    {
      "key": "shadow",
      "when": {},
      "text": ""
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "ask",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same crate. The same stencil, on the bottom as well.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "third_trial",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same board, the same curve. The chalk is new.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "inside",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same page. The same underline.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "shadow_ask",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same careful hand. The same crossing out.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "shadow_third_trial",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The sheet stayed on the board last time as well.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "shadow_end",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'Hands in his pockets last time too, the whole way up.'"
    },
    {
      "key": "remembrance",
      "when": {},
      "text": ""
    }
  ]
