  "lines": [
    {
      "key": "trial_title",
      "when": {
        "n": "1"
      },
      "text": "The First Broken Working"
    },
    {
      "key": "trial_title",
      "when": {
        "n": "2"
      },
      "text": "The Second Broken Working"
    },
    {
      "key": "trial_followup",
      "when": {
        "n": "1"
      },
      "text": "'One,' he says, and the Sending closes. 'Bring me the other kind.'"
    },
    {
      "key": "trial_followup",
      "when": {
        "n": "2"
      },
      "text": "'Two,' he says. 'Come and see the third. I have written sixty pages on it, and I would like someone to argue with.'"
    },
    {
      "key": "shadow",
      "when": {
        "beat": "ward",
        "traitor": "aurel"
      },
      "text": "Under your arm the Register notes, in its smallest hand, that the last ward this voice examined so closely was the Academy's, and that it examined it from the inside."
    },
    {
      "key": "shadow",
      "when": {
        "beat": "wound",
        "traitor": "aurel"
      },
      "text": "The Register writes the date of the wound beside his words. It is the date of Commencement. It does not remark on it."
    },
    {
      "key": "shadow",
      "when": {},
      "text": ""
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "ask",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'He asked for broken workings last time as well, and corrected the same word in the request.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "pages",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'Sixty pages. The same three errors. He has still not decided about the second.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "inside",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same annotation, in the same order. The last line has not changed.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "shadow_ask",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The second voice repeated him last time, too. Word for word.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "shadow_pages",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same confession. The same footnotes.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "shadow_end",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'He stood in the same place last time, in front of the same hand.'"
    },
    {
      "key": "remembrance",
      "when": {},
      "text": ""
    }
  ]
