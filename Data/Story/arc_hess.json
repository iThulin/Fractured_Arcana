  "lines": [
    {
      "key": "arrival_open",
      "when": {
        "route": "audit"
      },
      "text": "'Three,' she says. She does not say three what. You do not need her to."
    },
    {
      "key": "arrival_open",
      "when": {
        "route": "audience"
      },
      "text": "'You found me,' she says. 'Most people don't. Sit, if you like.'"
    },
    {
      "key": "arrival_reason",
      "when": {
        "route": "audit"
      },
      "text": "'Because you paid for things nobody would have paid you back for,' she says. 'Three times. Nobody was watching. I was.'"
    },
    {
      "key": "arrival_reason",
      "when": {
        "route": "audience"
      },
      "text": "'Because the land has decided about you,' she says, 'and I have stopped arguing with it.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "crow",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'A crow, last time as well. The Register does not think it is the same crow. The Register is not... certain.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "arrival",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same stone. The same reason. She has still told nobody else.'"
    },
    {
      "key": "remembrance",
      "when": {
        "beat": "inside",
        "remembered": "true"
      },
      "text": "'On file,' the Register murmurs. 'The same chair, the same hour. She sat down the same way.'"
    },
    {
      "key": "remembrance",
      "when": {},
      "text": ""
    }
  ]
