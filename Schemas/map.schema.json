{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://fracturedarcana/schemas/map.schema.json",
	"title": "Fractured Arcana Map Recipe",
	"type": "object",
	"required": [
		"id"
	],
	"additionalProperties": false,
	"properties": {
		"id": {
			"type": "string",
			"minLength": 1,
			"description": "Unique recipe id; set MapRecipeId to this."
		},
		"display_name": {
			"type": "string"
		},
		"shape": {
			"$ref": "#/$defs/shape"
		},
		"base_terrain": {
			"$ref": "#/$defs/baseTerrain"
		},
		"atmosphere": {
			"$ref": "#/$defs/atmosphere"
		},
		"features": {
			"type": "array",
			"items": {
				"$ref": "#/$defs/feature"
			}
		},
		"water": {
			"$ref": "#/$defs/water"
		},
		"sand": {
			"$ref": "#/$defs/sand"
		},
		"tactics": {
			"type": "object",
			"additionalProperties": false,
			"description": "Tactical targets checked after generation (HexGridManager.Tactics). Missed targets log a warning, never fail the map.",
			"properties": {
				"max_visibility": {
					"type": "number",
					"minimum": 0,
					"maximum": 1,
					"description": "Max fraction of player-zone x enemy-zone tile pairs with clear line of sight."
				},
				"min_cover": {
					"type": "number",
					"minimum": 0,
					"maximum": 1,
					"description": "Min fraction of open, unreserved tiles with cover on at least one side."
				}
			}
		},
		"siege": {
			"type": "object",
			"description": "Siege layout (city_battlemap_compiler_spec). Validated by SiegeSpec.FromDict."
		},
		"map_events": {
			"type": "array",
			"items": {
				"type": "object"
			},
			"description": "Per-round map events (CombatManager.MapEvents). Validated by MapEventDef."
		},
		"fallback": {
			"type": "string"
		},
		"terrain": {
			"type": "string"
		},
		"obstacles": {
			"type": "object",
			"additionalProperties": false,
			"description": "Obstacle dressing palette: which Data/Obstacles catalog kind each role resolves to on this map. Ops write \"kind\": \"low\" | \"high\" | \"pillar\" and get these. Missing roles fall back to a default keyed on the dominant base terrain.",
			"properties": {
				"low": {
					"type": "string"
				},
				"high": {
					"type": "string"
				},
				"pillar": {
					"type": "string"
				}
			}
		}
	},
	"$defs": {
		"intOrRange": {
			"description": "An integer, or a [min, max] range rolled at generation.",
			"oneOf": [
				{
					"type": "integer"
				},
				{
					"type": "array",
					"items": {
						"type": "integer"
					},
					"minItems": 1,
					"maxItems": 2
				}
			]
		},
		"color": {
			"description": "[r, g, b] or [r, g, b, a], each 0..1.",
			"type": "array",
			"items": {
				"type": "number",
				"minimum": 0,
				"maximum": 1
			},
			"minItems": 3,
			"maxItems": 4
		},
		"coord": {
			"description": "A named anchor, an axis token, or an explicit [q, r] axial coordinate. axis:N shifts the anchor midpoint N tiles along the player-to-enemy axis (negative = toward the player); flank:N shifts it N tiles perpendicular.",
			"oneOf": [
				{
					"type": "string",
					"enum": [
						"center",
						"midpoint",
						"random",
						"high_tile",
						"low_tile",
						"player_anchor",
						"enemy_anchor"
					]
				},
				{
					"type": "string",
					"pattern": "^(axis|flank):-?[0-9]+$"
				},
				{
					"type": "array",
					"items": {
						"type": "integer"
					},
					"minItems": 2,
					"maxItems": 2
				}
			]
		},
		"terrain": {
			"type": "string",
			"enum": [
				"grass",
				"forest",
				"stone",
				"water",
				"lava",
				"arcane",
				"ice",
				"sand"
			]
		},
		"shape": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"type": {
					"type": "string",
					"enum": [
						"parallelogram",
						"rectangle",
						"hexagon",
						"triangle",
						"blob"
					]
				},
				"width": {
					"type": "integer",
					"minimum": 1
				},
				"height": {
					"type": "integer",
					"minimum": 1
				},
				"radius": {
					"type": "integer",
					"minimum": 1,
					"description": "Used by hexagon / triangle / blob."
				},
				"erosion": {
					"type": "number",
					"minimum": 0,
					"maximum": 1,
					"description": "Blob edge raggedness."
				}
			}
		},
		"paletteRule": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"terrain"
			],
			"description": "First rule whose bounds all pass wins. Omit bounds for a fallback rule.",
			"properties": {
				"terrain": {
					"$ref": "#/$defs/terrain"
				},
				"max_elevation": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"min_elevation": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"max_moisture": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"min_moisture": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				}
			}
		},
		"baseTerrain": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"elevation_frequency": {
					"type": "number"
				},
				"moisture_frequency": {
					"type": "number"
				},
				"detail_weight": {
					"type": "number"
				},
				"max_height_step": {
					"type": "integer"
				},
				"min_height_step": {
					"type": "integer"
				},
				"palette": {
					"type": "array",
					"items": {
						"$ref": "#/$defs/paletteRule"
					}
				}
			}
		},
		"atmosphere": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"sun_color": {
					"$ref": "#/$defs/color"
				},
				"sun_energy": {
					"type": "number"
				},
				"ambient_color": {
					"$ref": "#/$defs/color"
				},
				"ambient_energy": {
					"type": "number"
				},
				"fog_color": {
					"$ref": "#/$defs/color"
				},
				"fog_density": {
					"type": "number"
				}
			}
		},
		"feature": {
			"type": "object",
			"additionalProperties": false,
			"required": [
				"feature"
			],
			"properties": {
				"feature": {
					"type": "string",
					"enum": [
						"lake",
						"river",
						"stream",
						"crevice",
						"mountainside",
						"meadow",
						"clearing",
						"scatter_copses",
						"rocky_outcrop",
						"obstacle_cluster",
						"height_hill",
						"height_basin",
						"carve_lane",
						"patch",
						"element_patch",
						"leyline",
						"obstacle_band",
						"cover_line",
						"height_ridge",
						"ring",
						"filled_radius",
						"map_object",
						"building_stamp"
					]
				},
				"phase": {
					"type": "string",
					"enum": [
						"skeleton",
						"accent"
					],
					"description": "skeleton = pre-spawn (layout), accent = post-spawn (dressing)."
				},
				"chance": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"at": {
					"$ref": "#/$defs/coord"
				},
				"from": {
					"$ref": "#/$defs/coord"
				},
				"to": {
					"$ref": "#/$defs/coord"
				},
				"radius": {
					"$ref": "#/$defs/intOrRange"
				},
				"depth": {
					"$ref": "#/$defs/intOrRange"
				},
				"length": {
					"$ref": "#/$defs/intOrRange"
				},
				"width": {
					"$ref": "#/$defs/intOrRange"
				},
				"peak": {
					"$ref": "#/$defs/intOrRange"
				},
				"count": {
					"$ref": "#/$defs/intOrRange"
				},
				"size": {
					"$ref": "#/$defs/intOrRange"
				},
				"dir": {
					"type": "integer",
					"minimum": 0,
					"maximum": 5,
					"description": "Hex direction index; omit for random."
				},
				"kind": {
					"type": "string",
					"description": "A role (low, high, pillar) resolved through the recipe's obstacles palette, or a concrete kind from Data/Obstacles/obstacle_catalog.json (rock, crystal, wall, broken_wall, rock_ledge, fallen_log, ...). For map_object: a MapObjectCatalog kind (cracked_pillar, resonant_crystal, ember_brazier, boulder, ward_stone, powder_cask)."
				},
				"terrain": {
					"$ref": "#/$defs/terrain"
				},
				"element": {
					"type": "string",
					"description": "TileElementType name, e.g. fire / frost / arcane."
				},
				"strength": {
					"type": "number"
				},
				"obstacle_kind": {
					"type": "string",
					"description": "ring / filled_radius payload: paint this obstacle kind. Low cover kinds keep sight clear."
				},
				"height": {
					"$ref": "#/$defs/intOrRange"
				},
				"branch": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"gaps": {
					"type": "integer",
					"minimum": 0,
					"description": "cover_line: guaranteed open tiles in the band, never at the ends. Default 1."
				},
				"fill": {
					"type": "number",
					"minimum": 0,
					"maximum": 1,
					"description": "cover_line: per-tile density on top of the gaps. Default 0.85. Distinct from chance, which gates the whole op."
				},
				"building_id": {
					"type": "string"
				}
			}
		},
		"water": {
			"type": "object",
			"additionalProperties": false,
			"description": "Water personality (S1.5). 'profile' names a preset in HexGridManager.WaterPlane (clear_lake, murky_swamp, grey_coast, black_bog); other fields override it.",
			"properties": {
				"profile": {
					"type": "string",
					"enum": [
						"clear_lake",
						"murky_swamp",
						"grey_coast",
						"black_bog"
					]
				},
				"shallow_color": {
					"$ref": "#/$defs/color"
				},
				"deep_color": {
					"$ref": "#/$defs/color"
				},
				"foam_color": {
					"$ref": "#/$defs/color"
				},
				"reflection_strength": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"cloud_strength": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"ripple": {
					"type": "number",
					"minimum": 0,
					"maximum": 3,
					"description": "Motion scale: ~0.2 still bog, 1 lake, ~1.5 choppy coast."
				},
				"foam_strength": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"foam_line": {
					"type": "number",
					"minimum": 0,
					"description": "Second detached foam line position in depth-band units. 0 = off."
				},
				"sparkle": {
					"type": "number",
					"minimum": 0,
					"maximum": 3
				},
				"alpha_shallow": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"alpha_deep": {
					"type": "number",
					"minimum": 0,
					"maximum": 1
				},
				"shore_lip": {
					"type": "number",
					"minimum": 0,
					"maximum": 0.4,
					"description": "Surface below the lowest bank: ~0.03 marsh film, ~0.10 lake edge, ~0.12+ coast."
				},
				"max_depth": {
					"type": "number",
					"minimum": 0.1,
					"maximum": 4
				}
			}
		},
		"sand": {
			"type": "object",
			"additionalProperties": false,
			"description": "Sand palette override for this map's sand_ground splat treatment (light = dune crests, warm = hollows). Omitted fields keep the shader defaults (beach).",
			"properties": {
				"light": {
					"$ref": "#/$defs/color"
				},
				"warm": {
					"$ref": "#/$defs/color"
				}
			}
		}
	}
}
